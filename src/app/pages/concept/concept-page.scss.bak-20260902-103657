:host { display: block; }
.concept-page { min-height: 100%; overflow: clip; background: var(--surface); color: var(--ink); }
.section-shell { width: min(var(--container), calc(100% - clamp(40px, 8vw, 144px))); margin-inline: auto; padding-block: clamp(88px, 10vw, 148px); }
.section-code { margin: 0 0 18px; color: var(--link); font-size: 12px; font-weight: 800; letter-spacing: .15em; }
h1, h2, h3, p { text-wrap: pretty; }
h1, h2, h3 { margin-top: 0; letter-spacing: -.035em; }
h2 { margin-bottom: 0; font-size: clamp(44px, 5vw, 70px); line-height: 1.06; font-weight: 650; }
h3 { margin-bottom: 0; }
.text-link { min-height: 44px; display: inline-flex; align-items: center; gap: 10px; color: var(--link); font-weight: 750; text-decoration-thickness: 1px; text-underline-offset: 7px; }
.button { min-height: 52px; padding: 0 26px; display: inline-flex; align-items: center; justify-content: center; gap: 14px; border: 1px solid transparent; border-radius: var(--radius-sm); text-decoration: none; font-weight: 760; }
.button--primary { background: var(--accent); color: var(--accent-ink); }
.theme-b .button--primary { background: var(--accent-deep); color: #fff; }
.button--secondary { color: var(--ink); border-color: var(--ink); background: color-mix(in srgb, var(--surface) 82%, transparent); }
.image-fallback { background: linear-gradient(135deg, var(--surface-muted), color-mix(in srgb, var(--accent) 18%, var(--surface))); }

.hero { min-height: min(810px, calc(100svh - 78px)); display: grid; grid-template-columns: minmax(0, 46%) minmax(0, 54%); position: relative; isolation: isolate; background: var(--surface); }
.hero-copy { padding: clamp(72px, 10vh, 124px) clamp(28px, 3.8vw, 72px) 72px max(24px, calc((100vw - var(--container)) / 2)); display: flex; flex-direction: column; justify-content: center; align-items: flex-start; position: relative; z-index: 2; }
.hero h1 { max-width: 12ch; margin: 0; font-size: clamp(54px, 5.6vw, 84px); line-height: 1.08; font-weight: 650; }
.hero-description { margin: 32px 0 0; font-size: clamp(18px, 1.45vw, 22px); color: var(--text-muted); }
.hero-actions { margin-top: 42px; display: flex; flex-wrap: wrap; gap: 16px; }
.hero-media { min-width: 0; position: relative; overflow: hidden; }
.hero-media > img:first-child { width: 100%; height: 100%; object-fit: cover; object-position: 68% 48%; }
.hero-foreground { position: absolute; width: 64%; max-width: none; right: -10%; bottom: -20%; opacity: .38; filter: saturate(.85); animation: slow-drift 12s ease-in-out infinite alternate; }
.theme-a .hero::after { content: ''; position: absolute; left: 46%; top: 0; bottom: 0; width: 1px; background: var(--line); z-index: 3; }
.theme-b .hero { grid-template-columns: 48% 52%; background-image: url('/media/c/hero.webp'); background-size: cover; background-position: center; }
.theme-b .hero-media { opacity: 0; }
.theme-b .hero-copy { margin: clamp(34px, 5vw, 76px); padding: clamp(42px, 5vw, 76px); align-self: end; min-height: 520px; border: 1px solid rgb(255 255 255 / .72); border-radius: 24px; background: rgb(238 248 252 / .92); backdrop-filter: blur(18px); box-shadow: 0 30px 80px rgb(6 43 87 / .18); }
.theme-b .hero-copy::before { content: ''; position: absolute; inset: 0; border-radius: inherit; border-left: 5px solid var(--accent); pointer-events: none; }

.section-heading { display: grid; gap: 4px; margin-bottom: clamp(44px, 6vw, 84px); }
.quick-access { padding-bottom: clamp(96px, 12vw, 180px); }
.quick-grid { display: grid; grid-template-columns: 1.7fr 1fr 1fr; border: 1px solid var(--line); border-radius: var(--radius-md); overflow: hidden; background: var(--surface); }
.quick-item { min-height: 370px; padding: clamp(30px, 4vw, 58px); display: grid; grid-template-rows: auto auto auto 1fr auto; align-items: start; border-left: 1px solid var(--line); position: relative; overflow: hidden; }
.quick-item:first-child { border-left: 0; }
.quick-item::before { content: ''; position: absolute; inset: 0; opacity: .08; background-image: url('/media/a/quick-access.webp'); background-size: cover; transition: opacity .3s, transform .5s; }
.quick-item:hover::before { opacity: .16; transform: scale(1.025); }
.quick-item > * { position: relative; z-index: 1; }
.quick-item .item-number { justify-self: end; color: var(--text-muted); font-variant-numeric: tabular-nums; }
.quick-item > app-symbol { font-size: 38px; color: var(--link); }
.quick-item h3 { margin-top: 42px; font-size: clamp(27px, 2.3vw, 38px); }
.quick-item p { color: var(--text-muted); font-size: 18px; }
.quick-item a { min-height: 48px; display: flex; align-items: center; justify-content: space-between; gap: 18px; color: var(--ink); text-decoration: none; font-weight: 760; border-top: 1px solid var(--line); padding-top: 18px; }
.quick-item--lead a { width: fit-content; min-width: 190px; padding: 14px 18px; border: 0; border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-ink); }
.theme-b .quick-access { width: 100%; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); background: #031f3a url('/media/c/quick-access.webp') center / cover fixed; color: #fff; }
.theme-b .quick-access .section-code { color: var(--accent-highlight); }
.theme-b .quick-access h2 { font-size: clamp(60px, 6.2vw, 88px); }
.theme-b .quick-grid { min-height: 550px; padding: 46px 2vw 46px 8vw; display: flex; align-items: center; overflow: visible; border: 0; background: transparent; }
.theme-b .quick-item { width: 38%; min-height: 390px; flex: 0 0 38%; padding: 46px; border: 1px solid rgb(25 207 242 / .55); border-radius: var(--radius-md); background: rgb(3 31 58 / .94); box-shadow: 0 32px 64px rgb(0 10 25 / .38); }
.theme-b .quick-item + .quick-item { margin-left: -7%; transform: scale(.91); }
.theme-b .quick-item:nth-child(3) { transform: scale(.82); }
.theme-b .quick-item::before { background-image: none; }
.theme-b .quick-item .item-number,
.theme-b .quick-item p { color: rgb(226 242 250 / .78); }
.theme-b .quick-item > app-symbol { color: #4fdcf2; }
.theme-b .quick-item--lead a { background: var(--accent-deep); color: #fff; }
.theme-b .quick-item a { color: #fff; border-color: rgb(255 255 255 / .24); }

.events { display: grid; grid-template-columns: 47% 53%; align-items: stretch; }
.events-media { min-height: 760px; overflow: hidden; border-radius: var(--radius-md) 0 0 var(--radius-md); }
.events-media img { width: 100%; height: 100%; object-fit: cover; object-position: 36% 50%; }
.events-copy { padding: clamp(42px, 6vw, 86px); border: 1px solid var(--line); border-left: 0; border-radius: 0 var(--radius-md) var(--radius-md) 0; background: var(--surface); }
.events-copy h2 { margin-bottom: 60px; }
.event-list { display: grid; }
.event-item { padding: 34px 0; border-top: 1px solid var(--line); }
.event-item > p { margin: 0 0 10px; color: var(--link); font-weight: 750; }
.event-item h3 { font-size: clamp(24px, 2vw, 33px); }
.event-item time { margin-top: 12px; display: block; color: var(--text-muted); }
.event-actions { margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; }
.theme-b .events { width: 100%; max-width: none; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); position: relative; background: linear-gradient(110deg, #eef8fc 0 57%, transparent 57%), url('/media/c/academic-events.webp') 75% center / cover; }
.theme-b .events-media { order: 2; min-height: 780px; opacity: 0; }
.theme-b .events-copy { order: 1; padding-left: 0; border: 0; background: transparent; }

.news-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
.news-heading .section-code { margin-bottom: 18px; }
.news-list { border-top: 1px solid var(--line); }
.news-item { min-width: 0; position: relative; border-bottom: 1px solid var(--line); }
.news-item > a { min-height: 150px; padding: 30px 18px; display: grid; grid-template-columns: 220px 1fr 40px; align-items: center; gap: 32px; color: var(--ink); text-decoration: none; }
.news-meta { display: flex; gap: 22px; color: var(--text-muted); }
.news-meta b { color: var(--link); }
.news-item h3 { font-size: clamp(23px, 2vw, 31px); }
.news-image { display: none; }
.theme-b .news { width: 100%; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); background: #031f3a; color: #fff; }
.theme-b .news-heading .text-link { color: #fff; }
.theme-b .news-list { min-height: 620px; display: flex; border: 0; gap: 3px; }
.theme-b .news-item { flex: 1 1 25%; min-width: 0; overflow: hidden; border: 0; background: var(--surface); transition: flex .45s ease; }
.theme-b .news-item.is-active { flex-basis: 50%; }
.theme-b .news-image { height: 62%; display: block; overflow: hidden; }
.theme-b .news-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
.theme-b .news-item.is-active .news-image img { transform: scale(1.035); }
.theme-b .news-item > a { min-height: 38%; padding: 26px; grid-template-columns: 1fr 28px; align-content: center; color: var(--ink); }
.theme-b .news-meta { grid-column: 1 / -1; justify-content: space-between; }
.theme-b .news-item h3 { font-size: clamp(20px, 2vw, 30px); }

.resources { display: grid; grid-template-columns: 50% 50%; align-items: stretch; }
.resources-media { min-height: 760px; overflow: hidden; border-radius: var(--radius-md) 0 0 var(--radius-md); }
.resources-media img { width: 100%; height: 100%; object-fit: cover; object-position: 52% 50%; }
.resources-copy { padding: clamp(42px, 6vw, 84px); border: 1px solid var(--line); border-left: 0; background: var(--surface); }
.resources-copy h2 { margin-bottom: 54px; }
.resource-grid { display: grid; grid-template-columns: 1fr 1fr; }
.resource-item { min-height: 220px; padding: 26px; display: grid; grid-template-columns: 36px 1fr; gap: 18px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.resource-item:nth-child(odd) { border-left: 0; }
.resource-item > app-symbol { font-size: 30px; color: var(--link); }
.resource-item h3 { font-size: clamp(22px, 1.8vw, 29px); }
.resource-item p { margin: 10px 0; color: var(--text-muted); }
.resource-item a { grid-column: 1 / -1; align-self: end; min-height: 44px; display: flex; align-items: center; justify-content: space-between; color: var(--link); font-weight: 750; text-decoration: none; }
.resource-item--lead { grid-column: 1 / -1; min-height: 240px; padding: 32px; }
.theme-b .resources { width: 100%; max-width: none; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); background: linear-gradient(180deg, #eef8fc, #dceef7); }
.theme-b .resources-media { order: 2; border-radius: 0 var(--radius-md) var(--radius-md) 0; }
.theme-b .resources-copy { order: 1; border-left: 1px solid var(--line); border-right: 0; }
.theme-b .resource-item--lead a { width: fit-content; min-width: 210px; padding: 0 20px; color: #fff; background: var(--accent-deep); border-radius: var(--radius-sm); }

.membership { width: 100%; max-width: none; min-height: 860px; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); display: grid; place-items: center; position: relative; isolation: isolate; background: #e5e9ed; }
.membership-media { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
.membership-media picture, .membership-media img { width: 100%; height: 100%; }
.membership-media img { object-fit: cover; object-position: 55% 48%; }
.membership-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(245 247 248 / .96), rgb(245 247 248 / .55) 55%, transparent); }
.membership-content { width: 100%; display: grid; grid-template-columns: 26% 74%; border: 1px solid var(--line); background: rgb(245 247 248 / .9); backdrop-filter: blur(18px); }
.membership-content > .section-heading { margin: 0; padding: 56px 38px; border-right: 1px solid var(--line); }
.member-grid { display: grid; grid-template-columns: 1fr 1fr; }
.member-action { min-height: 190px; padding: 34px; display: grid; grid-template-columns: 42px 1fr 28px; align-items: center; gap: 22px; color: var(--ink); text-decoration: none; border: 1px solid var(--line); border-width: 0 0 1px 1px; }
.member-action:nth-child(n+3) { border-bottom: 0; }
.member-action > app-symbol:first-child { font-size: 36px; color: var(--link); }
.member-action span { display: grid; gap: 8px; }
.member-action strong { font-size: clamp(24px, 2vw, 32px); }
.member-action small { color: var(--text-muted); font-size: 16px; }
.member-action--primary { background: #24272a; color: #fff; }
.member-action--primary small { color: rgb(255 255 255 / .7); }
.member-action--primary > app-symbol:first-child { color: var(--accent); }
.theme-b .membership { background: #031f3a; }
.theme-b .membership-media::after { background: linear-gradient(90deg, rgb(3 31 58 / .45), transparent); }
.theme-b .membership-media img { object-position: 50% 48%; }
.theme-b .membership-content { grid-template-columns: 1fr; max-width: 1180px; padding: clamp(28px, 4vw, 56px); background: rgb(238 248 252 / .94); border-radius: var(--radius-lg); box-shadow: 0 32px 80px rgb(0 12 35 / .36); }
.theme-b .membership-content > .section-heading { padding: 0 0 40px; border-right: 0; }
.theme-b .membership-content h2 { font-size: clamp(60px, 6vw, 84px); }
.theme-b .member-action { min-height: 150px; border: 1px solid var(--line); }
.theme-b .member-action--primary { background: var(--accent-deep); }

.concept-switcher { position: fixed; z-index: 60; right: 18px; bottom: 18px; display: flex; gap: 2px; padding: 4px; background: rgb(32 34 37 / .92); border-radius: 12px; box-shadow: 0 12px 30px rgb(0 0 0 / .25); backdrop-filter: blur(14px); }
.concept-switcher a { min-height: 40px; padding: 0 13px; display: flex; align-items: center; color: white; text-decoration: none; font-size: 13px; border-radius: 8px; }
.concept-switcher a:hover { background: rgb(255 255 255 / .12); }

.reveal-on-view { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s ease; }
.reveal-on-view.is-visible { opacity: 1; transform: translateY(0); }
@keyframes slow-drift { to { transform: translate3d(-14px, -9px, 0) rotate(1deg); } }

@media (max-width: 1199px) {
  .hero { min-height: 676px; grid-template-columns: 52% 48%; }
  .hero-copy { padding-left: 48px; }
  .theme-b .hero-copy { margin: 32px; padding: 46px; min-height: 500px; }
  .quick-grid { grid-template-columns: 1fr 1fr; }
  .quick-item--lead { grid-column: 1 / -1; }
  .quick-item:nth-child(3) { border-top: 1px solid var(--line); }
  .theme-b .quick-grid { padding-left: 3vw; }
  .events, .resources { grid-template-columns: 44% 56%; }
  .events-copy, .resources-copy { padding: 42px; }
  .membership-content { grid-template-columns: 1fr; }
  .membership-content > .section-heading { border-right: 0; border-bottom: 1px solid var(--line); }
}

@media (max-width: 767px) {
  .section-shell { width: calc(100% - 40px); padding-block: 72px; }
  h2 { font-size: clamp(38px, 12vw, 52px); }
  .hero, .theme-b .hero { min-height: auto; display: flex; flex-direction: column; background: var(--surface); }
  .hero-copy, .theme-b .hero-copy { order: 1; width: auto; min-height: auto; margin: 0; padding: 64px 20px 44px; border: 0; border-radius: 0; box-shadow: none; background: var(--surface); }
  .theme-b .hero-copy::before { display: none; }
  .hero h1 { font-size: clamp(42px, 12vw, 58px); }
  .hero-description { margin-top: 24px; font-size: 17px; }
  .hero-actions { width: 100%; margin-top: 32px; display: grid; }
  .hero-actions .button { width: 100%; }
  .hero-media, .theme-b .hero-media { order: 2; height: 58vw; min-height: 310px; opacity: 1; border-radius: 20px 20px 0 0; }
  .hero-foreground { display: none; }
  .theme-a .hero::after { display: none; }
  .quick-grid, .theme-b .quick-grid { display: grid; grid-template-columns: 1fr; min-height: 0; padding: 0; border: 1px solid var(--line); overflow: hidden; }
  .quick-item, .theme-b .quick-item { width: auto; min-height: 260px; margin: 0 !important; padding: 28px; transform: none !important; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; box-shadow: none; }
  .theme-b .quick-access { padding-inline: 20px; background-attachment: scroll; }
  .theme-b .quick-access h2, .theme-b .membership-content h2 { font-size: clamp(44px, 13vw, 60px); }
  .events, .theme-b .events, .resources, .theme-b .resources { width: calc(100% - 40px); padding-inline: 0; display: flex; flex-direction: column; background: var(--surface); }
  .events-media, .resources-media, .theme-b .events-media, .theme-b .resources-media { order: 1; width: 100%; min-height: 0; aspect-ratio: 16 / 10; opacity: 1; border-radius: var(--radius-md) var(--radius-md) 0 0; }
  .events-copy, .resources-copy, .theme-b .events-copy, .theme-b .resources-copy { order: 2; padding: 32px 24px; border: 1px solid var(--line); border-top: 0; border-radius: 0 0 var(--radius-md) var(--radius-md); background: var(--surface); }
  .events-copy h2 { margin-bottom: 36px; }
  .event-actions { align-items: stretch; flex-direction: column; }
  .news-heading { align-items: start; flex-direction: column; }
  .news-item > a { min-height: 136px; padding: 24px 0; grid-template-columns: 1fr 28px; gap: 16px; }
  .news-meta { grid-column: 1 / -1; justify-content: space-between; }
  .theme-b .news-list { min-height: 0; display: grid; gap: 16px; }
  .theme-b .news-item, .theme-b .news-item.is-active { display: grid; grid-template-columns: 42% 58%; }
  .theme-b .news-image { height: 100%; }
  .theme-b .news-item > a { min-height: 200px; padding: 18px; }
  .resource-grid { grid-template-columns: 1fr; }
  .resource-item, .resource-item:nth-child(odd) { grid-column: 1; border-left: 0; }
  .membership { min-height: 900px; padding-inline: 20px; }
  .membership-media::after { background: linear-gradient(180deg, rgb(245 247 248 / .65), rgb(245 247 248 / .9)); }
  .theme-b .membership-media::after { background: rgb(3 31 58 / .5); }
  .membership-content, .theme-b .membership-content { padding: 0; grid-template-columns: 1fr; }
  .theme-b .membership-content { padding: 26px 18px; }
  .membership-content > .section-heading { padding: 34px 24px; }
  .member-grid { grid-template-columns: 1fr; }
  .member-action, .theme-b .member-action { min-height: 112px; padding: 22px; border-left: 0; }
  .concept-switcher { right: 10px; bottom: 10px; }
  .reveal-on-view { opacity: 1; transform: none; }
}

@media (prefers-reduced-motion: reduce) {
  .hero-foreground { animation: none; }
  .reveal-on-view { opacity: 1; transform: none; }
  .theme-b .news-item, .theme-b .news-image img { transition: none; }
}
