.quick-item--lead a { width: fit-content; min-width: 190px; padding: 14px 18px; border: 0; border-radius: var(--radius-sm); background: var(--accent); color: var(--accent-ink); }
.theme-b .quick-access { width: 100%; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); background: var(--surface); color: var(--ink); }

/* Reference "numbered content section" pattern (spec section 5): a sticky left label
   panel with the page-level eyebrow + heading, paired with a right-hand vertically
   stacked list of full-width rows (not a card grid) — each row hover-fills solid accent
   with white text, 4px black rules divide rows and split the two panels. */
.quick-split { display: grid; grid-template-columns: 34% 66%; border: 4px solid var(--ink); }
.quick-label { padding: clamp(40px, 5vw, 88px); border-right: 4px solid var(--ink); position: relative; align-self: start; position: sticky; top: 112px; background: var(--surface-muted); }
.quick-label::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: radial-gradient(rgb(0 0 0 / .05) 1px, transparent 1px);
  background-size: 16px 16px;
}
.quick-label h2 { text-transform: uppercase; font-weight: 900; letter-spacing: -.03em; font-size: clamp(2.2rem, 1.8vw + 1.8rem, 3.6rem); }
.quick-list { display: grid; background: var(--surface); }
.quick-row {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: clamp(20px, 3vw, 40px);
  padding: clamp(28px, 3.6vw, 48px) clamp(28px, 4vw, 56px);
  border-bottom: 4px solid var(--ink);
  color: var(--ink);
  text-decoration: none;
  transition: background .18s ease-out, color .18s ease-out;
}
.quick-list .quick-row:last-child { border-bottom: 0; }
.quick-row-index { font-size: clamp(28px, 2.4vw, 40px); font-weight: 900; letter-spacing: -.02em; font-variant-numeric: tabular-nums; color: var(--text-muted); }
.quick-row-body { display: grid; gap: 10px; }
.quick-row-heading { display: flex; align-items: center; gap: 14px; }
.quick-row-heading app-symbol { font-size: 26px; color: var(--accent); }
.quick-row-heading h3 { text-transform: uppercase; font-weight: 700; font-size: clamp(22px, 1.8vw, 30px); }
.quick-row-body p { margin: 0; max-width: 46ch; color: var(--text-muted); font-size: 17px; }
.quick-row-arrow { font-size: 30px; transform: rotate(-45deg); transition: transform .18s ease-out; }
.quick-row:hover,
.quick-row:focus-visible { background: var(--accent); color: #fff; }
.quick-row:hover .quick-row-index,
.quick-row:focus-visible .quick-row-index,
.quick-row:hover .quick-row-body p,
.quick-row:focus-visible .quick-row-body p { color: rgb(255 255 255 / .82); }
.quick-row:hover .quick-row-heading app-symbol,
.quick-row:focus-visible .quick-row-heading app-symbol { color: #fff; }
.quick-row:hover .quick-row-arrow,
.quick-row:focus-visible .quick-row-arrow { transform: rotate(0deg); }

.events { display: grid; grid-template-columns: 47% 53%; align-items: stretch; }
.events-media { min-height: 760px; overflow: hidden; border-radius: var(--radius-md) 0 0 var(--radius-md); }
.events-media img { width: 100%; height: 100%; object-fit: cover; object-position: 36% 50%; }
.events-copy { padding: clamp(42px, 6vw, 86px); border: 1px solid var(--line); border-left: 0; border-radius: 0 var(--radius-md) var(--radius-md) 0; background: var(--surface); }
.events-copy h2 { margin-bottom: 60px; }
.event-list { display: grid; }
.event-item { padding: 34px 0; border-top: 1px solid var(--line); }
.event-item > p { margin: 0 0 10px; color: var(--link); font-weight: 750; }
.event-item h3 { font-size: clamp(24px, 2vw, 33px); }
.event-item time { margin-top: 12px; display: block; color: var(--text-muted); }
.event-actions { margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; }
.theme-b .events { width: 100%; max-width: none; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); grid-template-columns: 42% 58%; background: var(--surface); border-top: 4px solid var(--ink); border-bottom: 4px solid var(--ink); }
.theme-b .events-media { order: 1; min-height: 640px; opacity: 1; border-radius: 0; border-right: 4px solid var(--ink); }
.theme-b .events-media img { object-position: 50% 45%; }
.theme-b .events-copy { order: 2; padding: clamp(48px, 6vw, 96px); border: 0; border-radius: 0; background: var(--surface-muted); position: relative; }
.theme-b .events-copy::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: repeating-linear-gradient(45deg, rgb(0 0 0 / .025) 0 1px, transparent 1px 10px);
}
.theme-b .events-copy h2 { text-transform: uppercase; font-weight: 900; letter-spacing: -.03em; }
.theme-b .event-item { border-top: 2px solid var(--ink); }
.theme-b .event-item > p { text-transform: uppercase; letter-spacing: .12em; font-size: 13px; }

/* "03. Advantages"-style numbered badge row (spec section 8) for the events list — a
   bordered index-number box per row, hover-fills solid BLACK (not accent) with white
   text, distinguishing this section's hover language from quick-access's accent-fill
   rows. Body copy indents to align under the title, matching the badge width + gap. */
.theme-b .event-item--b { display: flex; align-items: flex-start; gap: 22px; padding: 30px 0; border-top: 2px solid var(--ink); transition: background .18s ease-out, color .18s ease-out; }
.theme-b .event-item--b:first-child { border-top: 2px solid var(--ink); }
.theme-b .event-index { flex: 0 0 auto; width: 48px; height: 48px; display: grid; place-items: center; border: 2px solid var(--ink); font-weight: 900; font-size: 18px; font-variant-numeric: tabular-nums; transition: border-color .18s ease-out, color .18s ease-out; }
.theme-b .event-item-body { flex: 1; min-width: 0; }
.theme-b .event-item-body > p { margin: 0 0 8px; text-transform: uppercase; letter-spacing: .12em; font-size: 13px; color: var(--accent); }
.theme-b .event-item--b:hover,
.theme-b .event-item--b:focus-within { background: var(--ink); color: #fff; }
.theme-b .event-item--b:hover .event-index,
.theme-b .event-item--b:focus-within .event-index { border-color: var(--accent); color: var(--accent); }
.theme-b .event-item--b:hover .event-item-body > p,
.theme-b .event-item--b:focus-within .event-item-body > p { color: var(--accent); }
.theme-b .event-item--b:hover time,
.theme-b .event-item--b:focus-within time { color: rgb(255 255 255 / .78); }

.news-heading { display: flex; align-items: end; justify-content: space-between; gap: 30px; }
.news-heading .section-code { margin-bottom: 18px; }
.news-list { border-top: 1px solid var(--line); }
.news-item { min-width: 0; position: relative; border-bottom: 1px solid var(--line); }
.news-item > a { min-height: 150px; padding: 30px 18px; display: grid; grid-template-columns: 220px 1fr 40px; align-items: center; gap: 32px; color: var(--ink); text-decoration: none; }
.news-meta { display: flex; gap: 22px; color: var(--text-muted); }
.news-meta b { color: var(--link); }
.news-item h3 { font-size: clamp(23px, 2vw, 31px); }
.news-image { display: none; }
.theme-b .news { width: 100%; padding-inline: 0; background: var(--surface); }

/* Reference "04. Journal" section (spec section 10): a left label column (eyebrow +
   heading + a bottom-pinned "view archive" CTA, textured/muted background) paired with a
   right-hand article-card grid. Runs full-bleed like the reference (no container gutter),
   date stamp styled uppercase + wide-tracked in the existing font stack instead of adding
   a monospace face. */
.news-split { display: grid; grid-template-columns: 25% 75%; border-top: 4px solid var(--ink); border-bottom: 4px solid var(--ink); }
.news-label { padding: clamp(40px, 5vw, 80px) clamp(28px, 3.2vw, 56px); border-right: 4px solid var(--ink); display: flex; flex-direction: column; justify-content: space-between; gap: 48px; position: relative; background: var(--surface-muted); }
.news-label::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: linear-gradient(to right, rgb(0 0 0 / .04) 1px, transparent 1px), linear-gradient(to bottom, rgb(0 0 0 / .04) 1px, transparent 1px);
  background-size: 24px 24px;
}
.news-label h2 { text-transform: uppercase; font-weight: 900; letter-spacing: -.03em; font-size: clamp(2rem, 1.6vw + 1.6rem, 3.2rem); }
.news-archive { width: 100%; }
.news-grid { display: grid; grid-template-columns: repeat(3, 1fr); background: var(--surface); }
.news-card { border-left: 4px solid var(--ink); border-top: 0; transition: background .18s ease-out, color .18s ease-out; }
.news-card:first-child { border-left: 0; }
.news-card.is-active { outline: 3px solid var(--accent); outline-offset: -3px; }
.news-card > a { min-height: 100%; padding: clamp(28px, 3vw, 44px); display: flex; flex-direction: column; justify-content: space-between; gap: 32px; color: var(--ink); text-decoration: none; }
.news-card .news-meta { display: block; }
.news-card .news-meta b { display: block; margin-bottom: 8px; text-transform: uppercase; letter-spacing: .16em; font-size: 12px; font-weight: 800; color: var(--accent); }
.news-card .news-meta time { display: block; text-transform: uppercase; letter-spacing: .12em; font-size: 12px; color: var(--text-muted); }
.news-card h3 { margin-top: 4px; font-size: clamp(21px, 1.8vw, 28px); font-weight: 700; line-height: 1.2; }
.news-read { display: inline-flex; align-items: center; gap: 10px; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: .04em; font-size: 14px; }
.news-card:hover,
.news-card:focus-within { background: var(--ink); }
.news-card:hover > a,
.news-card:focus-within > a { color: #fff; }
.news-card:hover .news-meta time,
.news-card:focus-within .news-meta time { color: rgb(255 255 255 / .78); }
.news-card:hover .news-read,
.news-card:focus-within .news-read { color: #fff; }

.resources { display: grid; grid-template-columns: 50% 50%; align-items: stretch; }
.resources-media { min-height: 760px; overflow: hidden; border-radius: var(--radius-md) 0 0 var(--radius-md); }
.resources-media img { width: 100%; height: 100%; object-fit: cover; object-position: 52% 50%; }
.resources-copy { padding: clamp(42px, 6vw, 84px); border: 1px solid var(--line); border-left: 0; background: var(--surface); }
.resources-copy h2 { margin-bottom: 54px; }
.resource-grid { display: grid; grid-template-columns: 1fr 1fr; }
.resource-item { min-height: 220px; padding: 26px; display: grid; grid-template-columns: 36px 1fr; gap: 18px; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.resource-item:nth-child(odd) { border-left: 0; }
.resource-item > app-symbol { font-size: 30px; color: var(--link); }
.resource-item h3 { font-size: clamp(22px, 1.8vw, 29px); }
.resource-item p { margin: 10px 0; color: var(--text-muted); }
.resource-item a { grid-column: 1 / -1; align-self: end; min-height: 44px; display: flex; align-items: center; justify-content: space-between; color: var(--link); font-weight: 750; text-decoration: none; }
.resource-item--lead { grid-column: 1 / -1; min-height: 240px; padding: 32px; }
.theme-b .resources { width: 100%; max-width: none; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); grid-template-columns: 45% 55%; background: var(--surface-muted); border-bottom: 4px solid var(--ink); position: relative; }
.theme-b .resources::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: radial-gradient(rgb(0 0 0 / .04) 1px, transparent 1px);
  background-size: 16px 16px;
}
.theme-b .resources-media { order: 2; border-radius: 0; border-left: 4px solid var(--ink); }
.theme-b .resources-copy { order: 1; border: 0; background: transparent; }
.theme-b .resources-copy h2 { text-transform: uppercase; font-weight: 900; letter-spacing: -.03em; }

/* Hairline grid technique (spec sections 4/12): a `gap` grid on a black background so the
   hairline gaps themselves become the dividers, with each card sitting on top as a white
   cell — a different rhythm from quick-access's fused full-width rows and events' bordered
   badge rows. Hover fills solid accent (page-level variety vs. events' black hover-fill). */
.theme-b .resource-grid { grid-template-columns: 1fr 1fr; gap: 4px; background: var(--ink); border: 4px solid var(--ink); }
.theme-b .resource-item { border: 0; background: var(--surface); transition: background .18s ease-out, color .18s ease-out; }
.theme-b .resource-item > app-symbol { color: var(--accent); }
.theme-b .resource-item a { color: var(--ink); text-transform: uppercase; font-weight: 700; letter-spacing: .04em; }
.theme-b .resource-item--lead a { width: fit-content; min-width: 0; padding: 0; color: var(--ink); background: transparent; border-radius: 0; border-top: 2px solid var(--ink); }
.theme-b .resource-item:hover,
.theme-b .resource-item:focus-within { background: var(--accent); color: #fff; }
.theme-b .resource-item:hover > app-symbol,
.theme-b .resource-item:focus-within > app-symbol { color: #fff; }
.theme-b .resource-item:hover p,
.theme-b .resource-item:focus-within p { color: rgb(255 255 255 / .82); }
.theme-b .resource-item:hover a,
.theme-b .resource-item:focus-within a { color: #fff; }

.membership { width: 100%; max-width: none; min-height: 860px; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); display: grid; place-items: center; position: relative; isolation: isolate; background: #e5e9ed; }
.membership-media { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
.membership-media picture, .membership-media img { width: 100%; height: 100%; }
.membership-media img { object-fit: cover; object-position: 55% 48%; }
.membership-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(245 247 248 / .96), rgb(245 247 248 / .55) 55%, transparent); }
.membership-content { width: 100%; display: grid; grid-template-columns: 26% 74%; border: 1px solid var(--line); background: rgb(245 247 248 / .9); backdrop-filter: blur(18px); }
.membership-content > .section-heading { margin: 0; padding: 56px 38px; border-right: 1px solid var(--line); }
.member-grid { display: grid; grid-template-columns: 1fr 1fr; }
.member-action { min-height: 190px; padding: 34px; display: grid; grid-template-columns: 42px 1fr 28px; align-items: center; gap: 22px; color: var(--ink); text-decoration: none; border: 1px solid var(--line); border-width: 0 0 1px 1px; }
.member-action:nth-child(n+3) { border-bottom: 0; }
.member-action > app-symbol:first-child { font-size: 36px; color: var(--link); }
.member-action span { display: grid; gap: 8px; }
.member-action strong { font-size: clamp(24px, 2vw, 32px); }
.member-action small { color: var(--text-muted); font-size: 16px; }
.member-action--primary { background: #24272a; color: #fff; }
.member-action--primary small { color: rgb(255 255 255 / .7); }
.member-action--primary > app-symbol:first-child { color: var(--accent); }
.theme-b .membership { width: 100%; max-width: none; min-height: 0; padding-inline: max(24px, calc((100vw - var(--container)) / 2)); display: grid; grid-template-columns: 45% 55%; place-items: stretch; position: relative; isolation: isolate; background: var(--surface); border-top: 4px solid var(--ink); }
.theme-b .membership-media { position: static; inset: auto; z-index: auto; min-height: 640px; border-right: 4px solid var(--ink); }
.theme-b .membership-media::after { content: none; }
.theme-b .membership-content { width: auto; grid-template-columns: 1fr; max-width: none; padding: clamp(48px, 6vw, 96px); border: 0; background: var(--surface-muted); box-shadow: none; backdrop-filter: none; position: relative; }
.theme-b .membership-content::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background-image: linear-gradient(to right, rgb(0 0 0 / .03) 1px, transparent 1px), linear-gradient(to bottom, rgb(0 0 0 / .03) 1px, transparent 1px);
  background-size: 24px 24px;
}
.theme-b .membership-content > .section-heading { padding: 0 0 40px; border-right: 0; }
.theme-b .membership-content h2 { text-transform: uppercase; font-weight: 900; letter-spacing: -.03em; }

/* Reference's "Investment" pricing-card device (spec section 11): each card gets its own
   full 4px border with visible gap between cards, reading as standalone boxes rather than
   a fused hairline grid — appropriate here since login/join/renew are meaningfully
   different individual actions, not a repeating list. */
.theme-b .member-grid { gap: 20px; }
.theme-b .member-action { min-height: 170px; border: 4px solid var(--ink); background: var(--surface); transition: background .18s ease-out, color .18s ease-out; }
.theme-b .member-action:hover,
.theme-b .member-action:focus-visible { background: var(--ink); color: #fff; }
.theme-b .member-action:hover > app-symbol:first-child,
.theme-b .member-action:focus-visible > app-symbol:first-child { color: var(--accent); }
.theme-b .member-action--primary { background: #000; color: #fff; }
.theme-b .member-action--primary:hover,
.theme-b .member-action--primary:focus-visible { background: var(--accent); }

.concept-switcher { position: fixed; z-index: 60; right: 18px; bottom: 18px; display: flex; gap: 2px; padding: 4px; background: rgb(32 34 37 / .92); border-radius: 12px; box-shadow: 0 12px 30px rgb(0 0 0 / .25); backdrop-filter: blur(14px); }
.concept-switcher a { min-height: 40px; padding: 0 13px; display: flex; align-items: center; color: white; text-decoration: none; font-size: 13px; border-radius: 8px; }
.concept-switcher a:hover { background: rgb(255 255 255 / .12); }

.reveal-on-view { opacity: 0; transform: translateY(18px); transition: opacity .65s ease, transform .65s ease; }
.reveal-on-view.is-visible { opacity: 1; transform: translateY(0); }
.theme-b .reveal-on-view { transition: opacity .18s ease-out, transform .18s ease-out; }

@media (max-width: 1199px) {
  .hero { min-height: 676px; grid-template-columns: 52% 48%; }
  .hero-copy { padding-left: 48px; }
  .theme-b .hero { min-height: min(760px, 100svh - 68px); }
  .theme-b .hero-copy--b { min-height: min(760px, 100svh - 68px); padding: clamp(72px, 11vh, 120px) 32px clamp(140px, 22vw, 200px); }
  .theme-b .hero-copy--b h1 { font-size: clamp(2.1rem, 2.4vw + 1.5rem, 3rem); }
  .theme-b .hero-watermark { font-size: clamp(3.2rem, 15vw, 8rem); }
  .quick-grid { grid-template-columns: 1fr 1fr; }
  .quick-item--lead { grid-column: 1 / -1; }
  .quick-item:nth-child(3) { border-top: 1px solid var(--line); }
  .quick-split { grid-template-columns: 40% 60%; }
  .events, .resources { grid-template-columns: 44% 56%; }
  .events-copy, .resources-copy { padding: 42px; }
  .news-split { grid-template-columns: 32% 68%; }
  .news-grid { grid-template-columns: 1fr 1fr; }
  .news-card:nth-child(3) { border-left: 0; border-top: 4px solid var(--ink); }
  .membership-content { grid-template-columns: 1fr; }
  .membership-content > .section-heading { border-right: 0; border-bottom: 1px solid var(--line); }
}

@media (max-width: 767px) {
  .section-shell { width: calc(100% - 40px); padding-block: 72px; }
  h2 { font-size: clamp(38px, 12vw, 52px); }
  .hero { min-height: auto; display: flex; flex-direction: column; background: var(--surface); }
  .hero-copy { order: 1; width: auto; min-height: auto; margin: 0; padding: 64px 20px 44px; border: 0; border-radius: 0; box-shadow: none; background: var(--surface); }
  .hero h1 { font-size: clamp(42px, 12vw, 58px); }
  .hero-description { margin-top: 24px; font-size: 17px; }
  .hero-actions { width: 100%; margin-top: 32px; display: grid; }
  .hero-actions .button { width: 100%; }
  .hero-media { order: 2; height: 58vw; min-height: 310px; opacity: 1; border-radius: 20px 20px 0 0; }
  /* CONCEPT B full-bleed hero stays a single stacked block at mobile (photo behind, corner
     content + watermark on top) rather than switching to the split-column mobile layout above. */
  .theme-b .hero { min-height: min(620px, 100svh - 60px); }
  .theme-b .hero-copy--b { grid-template-columns: 1fr; row-gap: 24px; min-height: min(620px, 100svh - 60px); padding: 56px 20px clamp(120px, 34vw, 170px); }
  .theme-b .hero-copy--b h1 { grid-column: 1; max-width: none; font-size: clamp(2rem, 9vw, 2.6rem); }
  .theme-b .hero-intro { grid-column: 1; }
  .theme-b .hero-intro .hero-actions { width: 100%; }
  .theme-b .hero-intro .hero-actions .button { flex: 1 1 auto; }
  .theme-b .hero-watermark { font-size: clamp(2.4rem, 17vw, 4.4rem); bottom: 10px; }
  .theme-a .hero::after { display: none; }
  .quick-grid { display: grid; grid-template-columns: 1fr; min-height: 0; padding: 0; border: 1px solid var(--line); overflow: hidden; }
  .quick-item { width: auto; min-height: 260px; margin: 0 !important; padding: 28px; transform: none !important; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; box-shadow: none; }
  .theme-b .quick-access { padding-inline: 20px; }
  .theme-b .quick-access h2, .theme-b .membership-content h2 { font-size: clamp(44px, 13vw, 60px); }
  .quick-split { grid-template-columns: 1fr; border-width: 3px; }
  .quick-label { position: static; border-right: 0; border-bottom: 3px solid var(--ink); padding: 32px 24px; }
  .quick-row { grid-template-columns: auto 1fr; padding: 24px; gap: 16px 18px; border-bottom-width: 3px; }
  .quick-row-arrow { grid-column: 1 / -1; justify-self: end; }
  .events, .theme-b .events, .resources, .theme-b .resources { width: calc(100% - 40px); padding-inline: 0; display: flex; flex-direction: column; background: var(--surface); }
  .events-media, .resources-media, .theme-b .events-media, .theme-b .resources-media { order: 1; width: 100%; min-height: 0; aspect-ratio: 16 / 10; opacity: 1; border-radius: var(--radius-md) var(--radius-md) 0 0; }
  .theme-b .events-media { border-right: 0; border-bottom: 4px solid var(--ink); }
  .theme-b .resources-media { border-left: 0; border-bottom: 4px solid var(--ink); }
  .events-copy, .resources-copy, .theme-b .events-copy, .theme-b .resources-copy { order: 2; padding: 32px 24px; border: 1px solid var(--line); border-top: 0; border-radius: 0 0 var(--radius-md) var(--radius-md); background: var(--surface); }
  .events-copy h2 { margin-bottom: 36px; }
  .event-actions { align-items: stretch; flex-direction: column; }
  .theme-b .event-item--b { gap: 16px; }
  .theme-b .event-index { width: 40px; height: 40px; font-size: 16px; }
  .news-heading { align-items: start; flex-direction: column; }
  .news-item > a { min-height: 136px; padding: 24px 0; grid-template-columns: 1fr 28px; gap: 16px; }
  .news-meta { grid-column: 1 / -1; justify-content: space-between; }
  .news-split { grid-template-columns: 1fr; border-width: 3px; }
  .news-label { border-right: 0; border-bottom: 3px solid var(--ink); flex-direction: column; gap: 32px; padding: 32px 24px; }
  .news-grid { grid-template-columns: 1fr; }
  .news-card { border-left: 0; border-top: 3px solid var(--ink); }
  .news-card:first-child { border-top: 0; }
  .resource-grid { grid-template-columns: 1fr; }
  .resource-item, .resource-item:nth-child(odd) { grid-column: 1; border-left: 0; }
  .theme-b .resource-grid { grid-template-columns: 1fr; border-width: 3px; }
  .membership { min-height: 900px; padding-inline: 20px; }
  .membership-media::after { background: linear-gradient(180deg, rgb(245 247 248 / .65), rgb(245 247 248 / .9)); }
  .theme-b .membership { grid-template-columns: 1fr; padding-inline: 20px; }
  .theme-b .membership-media { border-right: 0; border-bottom: 4px solid var(--ink); min-height: 320px; }
  .membership-content, .theme-b .membership-content { padding: 0; grid-template-columns: 1fr; }
  .theme-b .membership-content { padding: clamp(28px, 6vw, 48px) 20px; }
  .membership-content > .section-heading { padding: 34px 24px; }
  .member-grid { grid-template-columns: 1fr; }
  .member-action { min-height: 112px; padding: 22px; border-left: 0; }
  .theme-b .member-grid { gap: 14px; }
  .theme-b .member-action { min-height: 112px; padding: 22px; }
  .concept-switcher { right: 10px; bottom: 10px; }
  .reveal-on-view { opacity: 1; transform: none; }
}

@media (prefers-reduced-motion: reduce) {
  .reveal-on-view { opacity: 1; transform: none; }
  .news-card,
  .quick-row, .quick-row-arrow,
  .theme-b .event-item--b, .theme-b .event-index,
  .theme-b .resource-item,
  .theme-b .member-action { transition: none; }
}
