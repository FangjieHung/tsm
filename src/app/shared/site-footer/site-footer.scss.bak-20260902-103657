:host { display: block; }
.site-footer { min-height: 420px; padding: clamp(56px, 7vw, 96px) clamp(24px, 6vw, 96px) 42px; display: grid; grid-template-columns: 1.6fr 1fr .7fr; gap: 64px; align-content: center; background: #22272a; color: #f5f7f8; position: relative; overflow: hidden; }
.site-footer--c { background: linear-gradient(125deg, #031f3a, #064a91 70%, #078edb); }
.site-footer--c::after { content: ''; position: absolute; width: 420px; aspect-ratio: 1; right: -140px; bottom: -250px; border: 1px solid rgb(25 207 242 / .55); border-radius: 50%; box-shadow: inset 0 0 80px rgb(25 207 242 / .12); }
.footer-identity { display: flex; align-items: center; gap: 28px; position: relative; z-index: 1; }
.footer-logo { width: 132px; height: 132px; padding: 10px; flex: 0 0 auto; display: grid; background: #f5f7f8; }
.footer-logo img { width: 100%; height: 100%; object-fit: contain; }
.footer-identity div { display: grid; gap: 8px; }
.footer-identity strong { font-size: clamp(24px, 2.4vw, 38px); }
.footer-identity a, nav a, .footer-utility a { color: inherit; text-decoration: none; }
.footer-identity div > a { opacity: .72; }
nav { display: grid; gap: 14px; align-content: center; border-left: 1px solid rgb(255 255 255 / .3); padding-left: 56px; position: relative; z-index: 1; }
nav a, .footer-utility a { min-height: 38px; display: flex; align-items: center; }
nav a:hover, .footer-utility a:hover { color: var(--accent); }
.footer-utility { display: grid; gap: 10px; align-content: center; position: relative; z-index: 1; }
small { grid-column: 1 / -1; border-top: 1px solid rgb(255 255 255 / .25); padding-top: 28px; text-align: right; opacity: .72; }
@media (max-width: 900px) { .site-footer { grid-template-columns: 1fr 1fr; } .footer-utility { grid-column: 2; } }
@media (max-width: 640px) { .site-footer { grid-template-columns: 1fr; gap: 36px; } .footer-identity { align-items: flex-start; } .footer-logo { width: 96px; height: 96px; } nav { grid-template-columns: 1fr 1fr; padding: 28px 0 0; border-left: 0; border-top: 1px solid rgb(255 255 255 / .25); } .footer-utility { grid-column: 1; } small { text-align: left; } }
