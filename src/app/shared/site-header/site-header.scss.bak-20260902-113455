:host { display: block; position: relative; z-index: 40; }
.site-header {
  min-height: 78px;
  padding: 10px clamp(20px, 4.8vw, 72px);
  display: grid;
  grid-template-columns: 64px 1fr auto;
  align-items: center;
  gap: clamp(20px, 3vw, 48px);
  color: var(--ink);
  background: color-mix(in srgb, var(--surface) 94%, transparent);
  border-bottom: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
  backdrop-filter: blur(18px);
}
.brand { width: 58px; height: 58px; display: grid; place-items: center; }
.brand img { width: 100%; height: 100%; object-fit: contain; }
nav { display: flex; align-items: center; justify-content: flex-end; gap: clamp(18px, 2.4vw, 40px); }
nav a, .login-link { color: inherit; text-decoration: none; font-weight: 650; letter-spacing: .02em; }
nav a { position: relative; padding: 14px 0; }
nav a::after { content: ''; position: absolute; inset: auto 0 7px; height: 2px; background: var(--link); transform: scaleX(0); transform-origin: right; transition: transform .25s ease; }
nav a:hover::after, nav a:focus-visible::after { transform: scaleX(1); transform-origin: left; }
.login-link { min-height: 48px; padding: 0 22px; display: inline-flex; align-items: center; gap: 9px; background: var(--button-bg); color: var(--button-ink); border-radius: var(--radius-sm); }
.login-link app-symbol { font-size: 20px; }
.menu-toggle { display: none; width: 48px; height: 48px; border: 1px solid var(--line); color: var(--ink); background: var(--surface); border-radius: var(--radius-sm); }
.menu-toggle app-symbol { font-size: 28px; }
@media (max-width: 1199px) {
  .site-header { grid-template-columns: 58px 1fr auto auto; min-height: 92px; }
  nav { justify-self: end; }
  nav a:nth-child(-n+3) { display: none; }
  .menu-toggle { display: grid; place-items: center; grid-column: 3; }
  .login-link { grid-column: 4; }
}
@media (max-width: 767px) {
  .site-header { min-height: 70px; padding: 8px 20px; grid-template-columns: 48px 1fr 48px; }
  .brand { width: 46px; height: 46px; }
  .menu-toggle { grid-column: 3; }
  .login-link { display: none; }
  nav { position: absolute; top: 100%; left: 0; right: 0; display: grid; gap: 0; padding: 10px 20px 20px; background: var(--surface); border-bottom: 1px solid var(--line); box-shadow: 0 24px 48px rgb(0 0 0 / .12); transform: translateY(-8px); opacity: 0; visibility: hidden; transition: opacity .2s, transform .2s, visibility .2s; }
  nav.is-open { opacity: 1; visibility: visible; transform: translateY(0); }
  nav a, nav a:nth-child(-n+3) { display: block; min-height: 48px; padding: 14px 4px; border-bottom: 1px solid var(--line); }
}
@media (prefers-reduced-motion: reduce) { nav, nav a::after { transition: none; } }

/* Swiss International Style header overrides for concept-b only — flat white background,
   thick black rule, uppercase wide-tracked nav labels, hard color-invert hover states.
   Colors/radius already flow through the .theme-b CSS custom properties (--surface,
   --ink, --button-bg, --radius-sm are already swapped globally); this block only adds the
   typography treatment, the thicker border, and removes the shared glassmorphism blur. */
.site-header--c {
  background: var(--surface);
  border-bottom: 4px solid var(--ink);
  backdrop-filter: none;
}
.site-header--c nav a { text-transform: uppercase; font-weight: 700; letter-spacing: .06em; }
.site-header--c nav a::after { background: var(--accent); height: 3px; transition: transform .18s ease-out; }
.site-header--c .login-link { text-transform: uppercase; font-weight: 700; letter-spacing: .06em; transition: background .18s ease-out, color .18s ease-out; }
.site-header--c .login-link:hover,
.site-header--c .login-link:focus-visible { background: var(--accent); color: #fff; }
.site-header--c .menu-toggle { border-color: var(--ink); transition: background .18s ease-out, color .18s ease-out; }
.site-header--c .menu-toggle:hover,
.site-header--c .menu-toggle:focus-visible { background: var(--ink); color: #fff; }
@media (max-width: 767px) {
  .site-header--c nav { box-shadow: none; border: 4px solid var(--ink); border-top: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .site-header--c nav a::after, .site-header--c .login-link, .site-header--c .menu-toggle { transition: none; }
}
